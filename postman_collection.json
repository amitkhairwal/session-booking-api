{
  "info": {
    "name": "Session Booking API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000"
    },
    {
      "key": "userId",
      "value": ""
    },
    {
      "key": "teacherId",
      "value": ""
    },
    {
      "key": "sessionId",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Create user",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.collectionVariables.set(\"userId\", pm.response.json()._id);"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"fullName\": \"Asha Rao\",\n  \"email\": \"asha1792394568613@example.com\",\n  \"phone\": \"9876543210\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/users",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "users"
          ]
        }
      }
    },
    {
      "name": "Create teacher",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.collectionVariables.set(\"teacherId\", pm.response.json()._id);"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"fullName\": \"Ravi Kumar\",\n  \"email\": \"ravi@example.com\",\n  \"specialization\": \"Mathematics\",\n  \"experience\": 8\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/teachers",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "teachers"
          ]
        }
      }
    },
    {
      "name": "Create session",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.collectionVariables.set(\"sessionId\", pm.response.json()._id);"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"teacherId\": \"{{teacherId}}\",\n  \"startTime\": \"2026-10-20T10:00:00.000Z\",\n  \"endTime\": \"2026-10-20T11:00:00.000Z\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/sessions",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "sessions"
          ]
        }
      }
    },
    {
      "name": "Available sessions",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/sessions/available?dateTimestamp=1792458000000",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "sessions",
            "available"
          ],
          "query": [
            {
              "key": "dateTimestamp",
              "value": "1792458000000"
            }
          ]
        }
      }
    },
    {
      "name": "Book session",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"userId\": \"{{userId}}\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/sessions/{{sessionId}}/book",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "sessions",
            "{{sessionId}}",
            "book"
          ]
        }
      }
    },
    {
      "name": "Book session again (expect 409)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"userId\": \"{{userId}}\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/sessions/{{sessionId}}/book",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "sessions",
            "{{sessionId}}",
            "book"
          ]
        }
      }
    },
    {
      "name": "Complete session",
      "request": {
        "method": "PATCH",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/sessions/{{sessionId}}/complete",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "sessions",
            "{{sessionId}}",
            "complete"
          ]
        }
      }
    },
    {
      "name": "User sessions",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/users/{{userId}}/sessions",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "users",
            "{{userId}}",
            "sessions"
          ]
        }
      }
    }
  ]
}
